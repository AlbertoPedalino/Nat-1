# Supabase cloud sync (optional). Without these the app runs 100% local.
# Get them from your Supabase project: Settings > API.
# The anon key is SAFE to ship in a static frontend (protected by Row Level Security).
# NEVER put the service_role key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Synthetic email domain used to turn a username into an email for Supabase Auth.
# Players never see it; they log in with just username + password.
VITE_AUTH_EMAIL_DOMAIN=players.gmboard.local
